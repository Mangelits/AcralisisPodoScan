rules_version = '2';

// Reglas de seguridad de Cloud Storage (tarea 8.1).
// Solo el profesional que sube una imagen puede leerla. Punto de partida
// restrictivo; se endurece en el bloque 8.
service firebase.storage {
  match /b/{bucket}/o {

    // Por defecto: denegar todo.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Imágenes de lesiones agrupadas por uid del profesional.
    match /lesions/{uid}/{imageId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
