# === Acralis AI · plantilla de variables de entorno ===
# Copia este fichero a `.env` y rellena los valores.
# NUNCA subas el fichero `.env` real al repositorio.

# --- Firebase / Google Cloud ---
# ID del proyecto Firebase (dev o prod). En local se usan los emuladores.
FIREBASE_PROJECT_ID=acralis-dev
# Región europea para cumplir RGPD con datos de salud.
FIREBASE_REGION=europe-west1

# --- Emuladores (desarrollo local) ---
# Los microservicios apuntan a estos hosts cuando se desarrolla en local.
FIRESTORE_EMULATOR_HOST=firebase-emulators:8080
FIREBASE_AUTH_EMULATOR_HOST=firebase-emulators:9099
FIREBASE_STORAGE_EMULATOR_HOST=firebase-emulators:9199

# --- MS1 · Ingesta (Scopus / genómica) ---
# Clave institucional de Scopus (solicitar a la universidad en el Sprint 1 · tarea 4.2).
SCOPUS_API_KEY=
# Base de la API del Genomic Data Commons (TCGA/GDC).
GDC_API_BASE=https://api.gdc.cancer.gov

# --- MS2 · Procesamiento / IA ---
# Versión del modelo cargado (se expone en la respuesta de /analyze).
MODEL_VERSION=0.0.0-dev

# --- URLs internas de los servicios (red de docker-compose) ---
MS1_URL=http://ms1-ingesta:8001
MS2_URL=http://ms2-procesamiento:8002
